# Copy this file to .env.production and fill in values from your CDK deployment outputs.
NEXT_PUBLIC_API_URL=https://<api-id>.execute-api.<region>.amazonaws.com
NEXT_PUBLIC_COGNITO_DOMAIN=https://<domain-prefix>.auth.<region>.amazoncognito.com
NEXT_PUBLIC_COGNITO_CLIENT_ID=<cognito-user-pool-client-id>
